# Copy to .env (or set in your hosting dashboard). Never commit real values.
NODE_ENV=production
PORT=3000
# Public address of the site, used for canonical URLs, sitemap and Open Graph
SITE_URL=https://www.example.com
# Long random strings, e.g. from: openssl rand -base64 48
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Set to 1 when running behind a proxy/load balancer that terminates HTTPS
TRUST_PROXY=1
# Where appointment records, content edits, uploads and backups are kept (mount a persistent disk here)
DATA_DIR=/data
# Optional: cookie-free Plausible analytics for this domain (only loaded when the site is live)
PLAUSIBLE_DOMAIN=
# Optional: set to 0 to omit FAQPage structured data
FAQ_SCHEMA=1
# Daily backups kept in DATA_DIR/backups (set BACKUPS=0 to disable)
BACKUP_KEEP=14
